# LAN-адрес Windows-хоста: нужен браузерам для WebRTC-медиа (ICE-кандидат).
# Узнать: ipconfig → IPv4-адрес активного адаптера (например, 192.168.1.151).
HOST_LAN_IP=192.168.1.151

# Диапазон автопоиска камер по умолчанию (CIDR или диапазон).
DISCOVERY_RANGE=192.168.1.0/24

# Часовой пояс контейнера: расписания записи и имена файлов используют локальное время.
TZ=Europe/Moscow