{
  "name": "MollyNVR",
  "short_name": "MollyNVR",
  "description": "Video surveillance: watch your cameras and record on a schedule.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/live",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0e1117",
  "theme_color": "#12151b",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
